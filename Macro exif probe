<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Macro / EXIF Distance Probe</title>
<style>
  :root {
    --bg: #0b1017; --panel: #151c26; --line: #263140; --text: #e8edf4;
    --dim: #8a97a8; --accent: #4fc3f7; --good: #4caf50; --bad: #ef5350; --warn: #ffb74d;
  }
  * { box-sizing: border-box; }
  body { margin:0; padding:12px; background:var(--bg); color:var(--text);
    font:14px/1.4 -apple-system, Roboto, "Segoe UI", sans-serif; }
  h1 { font-size:18px; margin:0 0 4px; }
  h2 { font-size:14px; margin:18px 0 6px; color:var(--accent); }
  .sub { color:var(--dim); font-size:12px; margin-bottom:14px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:12px; margin-bottom:12px; }
  video { width:100%; max-height:38vh; background:#000; border-radius:8px; display:block; object-fit:contain; }
  img.thumb { width:100%; max-height:30vh; object-fit:contain; background:#000; border-radius:8px; margin-top:8px; }
  .row { display:flex; gap:8px; flex-wrap:wrap; margin-top:8px; }
  button { flex:1; min-width:80px; padding:12px 10px; border:none; border-radius:8px;
    background:#26333f; color:var(--text); font-size:14px; font-weight:600; cursor:pointer;
    -webkit-tap-highlight-color:transparent; text-align:left; }
  button:active { background:#33445a; }
  button.primary { background:var(--accent); color:#05131a; }
  button.danger { background:var(--bad); color:#fff; }
  button.small { flex:0 0 auto; font-weight:400; font-size:12px; padding:8px 10px; }
  button:disabled { opacity:0.4; }
  input[type=number], input[type=text] { width:100%; padding:10px; border-radius:8px;
    border:1px solid var(--line); background:#0e141c; color:var(--text); font-size:16px; }
  .kv { display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px solid var(--line); font-size:13px; gap:8px; }
  .kv:last-child { border-bottom:none; }
  .kv b { color:var(--dim); font-weight:400; }
  .kv span { text-align:right; word-break:break-word; }
  .ok { color:var(--good); } .no { color:var(--bad); } .maybe { color:var(--warn); }
  table { width:100%; border-collapse:collapse; font-size:11px; margin-top:8px; }
  th, td { padding:4px 5px; text-align:left; border-bottom:1px solid var(--line); }
  th { color:var(--dim); font-weight:400; position:sticky; top:0; background:var(--panel); }
  .logwrap { max-height:220px; overflow-y:auto; border:1px solid var(--line); border-radius:8px; }
  .devbtn.active { outline:2px solid var(--accent); }
</style>
</head>
<body>

<h1>Macro / EXIF Distance Probe</h1>
<div class="sub">Tests two untested scale signals: (1) whether this phone exposes a separate macro camera to the browser with its own fixed geometry, and (2) whether captured photos carry real FocalLength / SubjectDistance EXIF data — a path that comes from the native camera pipeline, not the WebRTC track telemetry that already failed to update.</div>

<div class="panel">
  <video id="preview" autoplay playsinline muted></video>
  <div class="row">
    <button id="btnStart" class="primary">Start Camera</button>
  </div>
</div>

<div class="panel" id="devicesPanel" style="display:none">
  <h2>Idea 1 — Available cameras</h2>
  <div class="sub">Every back-facing camera this browser can select. If your phone has a separate macro lens, it may show up here as its own device with a different label and a different zoom/focus range from the main camera. Tap one to switch to it and see its capabilities below.</div>
  <div id="deviceList"></div>
</div>

<div class="panel" id="capsPanel" style="display:none">
  <h2>Active camera capabilities</h2>
  <div id="capsOut"></div>
</div>

<div class="panel" id="capturePanel" style="display:none">
  <h2>Idea 2 — Capture a real photo and read its EXIF</h2>
  <div class="sub">Uses ImageCapture.takePhoto() — a real photo from the native camera pipeline, not the live WebRTC track that turned out not to update. Point at your object at a known tape distance, tap Take Photo, check the fields below, then log it.</div>
  <div class="row">
    <button id="btnPhoto" class="primary">Take Photo</button>
  </div>
  <img id="thumb" class="thumb" style="display:none">
  <div id="exifOut" style="margin-top:8px"></div>

  <div class="row" style="margin-top:12px">
    <input type="number" id="actualDist" placeholder="Tape reading, cm" inputmode="decimal">
    <button id="btnLog" class="small" style="flex:0 0 90px">Log this</button>
  </div>
</div>

<div class="panel" id="verdictPanel" style="display:none">
  <h2>Verdict — what would we tell the customer?</h2>
  <div class="sub">Runs after each photo. Checks every signal this session knows how to look for. Only a signal that needs zero per-device calibration counts as a real pass — a signal that exists but needs a calibration table this customer's specific phone model doesn't have isn't usable in production, so it's shown as a caveat, not a green light.</div>
  <div id="verdictSignals"></div>
  <div id="verdictBanner" style="margin-top:10px; padding:12px; border-radius:8px; font-weight:600;"></div>
</div>

<div class="panel" id="logPanel" style="display:none">
  <h2>Log</h2>
  <div class="row">
    <button id="btnDownload">Download CSV</button>
    <button id="btnClear" class="danger">Clear Log</button>
  </div>
  <div class="logwrap">
    <table>
      <thead><tr><th>#</th><th>cam</th><th>cm</th><th>focal</th><th>35mm</th><th>subjDist</th><th>subjRange</th><th>zoom</th></tr></thead>
      <tbody id="logBody"></tbody>
    </table>
  </div>
  <div class="sub" id="logCount" style="margin-top:6px">0 captures logged</div>
</div>

<script>
const STORAGE_KEY = 'macroExifLog_v1';
let currentStream = null, currentTrack = null, currentLabel = '', log = [], lastExif = null, lastMeta = null;

try {
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) log = JSON.parse(saved);
} catch (e) { log = []; }
function persist() { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(log)); } catch (e) {} }

function renderLog() {
  const body = document.getElementById('logBody');
  body.innerHTML = '';
  log.forEach((r, i) => {
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${i}</td><td>${r.camera}</td><td>${r.cm ?? ''}</td><td>${r.focalLength ?? ''}</td><td>${r.focalLength35mm ?? ''}</td><td>${r.subjectDistance ?? ''}</td><td>${r.subjectDistanceRange ?? ''}</td><td>${r.zoom ?? ''}</td>`;
    body.appendChild(tr);
  });
  document.getElementById('logCount').textContent = `${log.length} captures logged`;
}
renderLog();

// ---- minimal EXIF parser: JPEG -> APP1 -> TIFF -> IFD0 -> Exif sub-IFD ----
function parseExif(buffer) {
  const view = new DataView(buffer);
  if (view.byteLength < 4 || view.getUint16(0, false) !== 0xFFD8) return null;
  let offset = 2;
  while (offset < view.byteLength - 4) {
    if (view.getUint8(offset) !== 0xFF) break;
    const marker = view.getUint8(offset + 1);
    if (marker === 0xE1) {
      const segLen = view.getUint16(offset + 2, false);
      const headerOffset = offset + 4;
      if (view.getUint32(headerOffset, false) === 0x45786966) { // "Exif"
        return readTiff(view, headerOffset + 6);
      }
      offset += 2 + segLen;
    } else if (marker === 0xD8 || (marker >= 0xD0 && marker <= 0xD9) || marker === 0x01) {
      offset += 2;
    } else if (marker === 0xDA) {
      break; // start of scan -- no more metadata segments
    } else {
      const segLen = view.getUint16(offset + 2, false);
      offset += 2 + segLen;
    }
  }
  return null;
}

function readTiff(view, tiffStart) {
  const little = view.getUint16(tiffStart, false) === 0x4949;
  const u16 = (o) => view.getUint16(o, little);
  const u32 = (o) => view.getUint32(o, little);
  const i32 = (o) => view.getInt32(o, little);
  const typeSize = { 1:1, 2:1, 3:2, 4:4, 5:8, 7:1, 9:4, 10:8 };

  function readIFD(ifdOffset) {
    const count = u16(ifdOffset);
    const out = {};
    for (let i = 0; i < count; i++) {
      const e = ifdOffset + 2 + i * 12;
      const tag = u16(e), type = u16(e + 2), n = u32(e + 4);
      const size = (typeSize[type] || 4) * n;
      const valOff = size <= 4 ? e + 8 : tiffStart + u32(e + 8);
      let value = null;
      if (type === 3) value = n === 1 ? u16(valOff) : Array.from({length:n}, (_,k) => u16(valOff + k*2));
      else if (type === 4) value = n === 1 ? u32(valOff) : Array.from({length:n}, (_,k) => u32(valOff + k*4));
      else if (type === 5) { const num = u32(valOff), den = u32(valOff + 4); value = den ? num/den : 0; }
      else if (type === 10) { const num = i32(valOff), den = i32(valOff + 4); value = den ? num/den : 0; }
      else if (type === 2) { let s = ''; for (let k=0;k<n-1;k++) s += String.fromCharCode(view.getUint8(valOff+k)); value = s; }
      out[tag] = value;
    }
    return out;
  }

  try {
    const ifd0Offset = u32(tiffStart + 4);
    const ifd0 = readIFD(ifd0Offset);
    let exifIFD = {};
    if (ifd0[0x8769]) exifIFD = readIFD(tiffStart + ifd0[0x8769]);
    return {
      make: ifd0[0x010F] || null,
      model: ifd0[0x0110] || null,
      focalLength: exifIFD[0x920A] ?? null,
      focalLength35mm: exifIFD[0xA405] ?? null,
      subjectDistance: exifIFD[0x9206] ?? null,
      subjectDistanceRange: exifIFD[0xA40C] ?? null,
      fNumber: exifIFD[0x829D] ?? null,
      lensModel: exifIFD[0xA434] || null,
    };
  } catch (e) {
    return { error: e.message };
  }
}

// ---- camera start / switch ----
async function startCamera(deviceId) {
  if (currentStream) currentStream.getTracks().forEach(t => t.stop());
  const constraints = deviceId
    ? { video: { deviceId: { exact: deviceId } } }
    : { video: { facingMode: { ideal: 'environment' } } };
  currentStream = await navigator.mediaDevices.getUserMedia(constraints);
  document.getElementById('preview').srcObject = currentStream;
  currentTrack = currentStream.getVideoTracks()[0];
  currentLabel = currentTrack.label || 'unnamed';

  const caps = currentTrack.getCapabilities ? currentTrack.getCapabilities() : {};
  const settings = currentTrack.getSettings ? currentTrack.getSettings() : {};
  let html = '';
  html += `<div class="kv"><b>label</b><span>${currentLabel}</span></div>`;
  html += `<div class="kv"><b>facingMode</b><span>${settings.facingMode ?? '—'}</span></div>`;
  html += `<div class="kv"><b>zoom</b><span>${caps.zoom ? `min ${caps.zoom.min}, max ${caps.zoom.max}, step ${caps.zoom.step}` : 'not exposed'}</span></div>`;
  html += `<div class="kv"><b>focusDistance</b><span>${caps.focusDistance ? `min ${caps.focusDistance.min}, max ${caps.focusDistance.max}` : 'not exposed'}</span></div>`;
  html += `<div class="kv"><b>current zoom setting</b><span>${settings.zoom ?? '—'}</span></div>`;
  document.getElementById('capsOut').innerHTML = html;
  document.getElementById('capsPanel').style.display = 'block';
  document.getElementById('capturePanel').style.display = 'block';
  document.getElementById('logPanel').style.display = 'block';

  // refresh device list now that labels are populated (only available post-permission)
  const devices = await navigator.mediaDevices.enumerateDevices();
  const videoInputs = devices.filter(d => d.kind === 'videoinput');
  const listEl = document.getElementById('deviceList');
  listEl.innerHTML = '';
  videoInputs.forEach(d => {
    const btn = document.createElement('button');
    btn.className = 'devbtn' + (d.deviceId === (currentTrack.getSettings().deviceId || '') ? ' active' : '');
    btn.textContent = d.label || `(unlabeled camera, id ${d.deviceId.slice(0,8)}…)`;
    btn.addEventListener('click', () => startCamera(d.deviceId));
    listEl.appendChild(btn);
  });
  document.getElementById('devicesPanel').style.display = 'block';
}

document.getElementById('btnStart').addEventListener('click', async () => {
  document.getElementById('btnStart').disabled = true;
  document.getElementById('btnStart').textContent = 'Camera running';
  try {
    await startCamera(null);
  } catch (e) {
    alert('Camera error: ' + e.message);
    document.getElementById('btnStart').disabled = false;
  }
});

// ---- take photo + parse EXIF ----
document.getElementById('btnPhoto').addEventListener('click', async () => {
  if (!currentTrack) return;
  const out = document.getElementById('exifOut');
  out.innerHTML = '<div class="sub">Capturing…</div>';
  try {
    const ic = new ImageCapture(currentTrack);
    const blob = await ic.takePhoto();
    const buf = await blob.arrayBuffer();
    lastExif = parseExif(buf);
    lastMeta = { zoom: currentTrack.getSettings().zoom ?? null };

    const url = URL.createObjectURL(blob);
    const thumb = document.getElementById('thumb');
    thumb.src = url;
    thumb.style.display = 'block';

    if (!lastExif) {
      out.innerHTML = '<div class="kv"><b>EXIF</b><span class="no">no EXIF segment found in this photo</span></div>';
    } else if (lastExif.error) {
      out.innerHTML = `<div class="kv"><b>EXIF parse error</b><span class="no">${lastExif.error}</span></div>`;
    } else {
      let html = '';
      html += `<div class="kv"><b>make / model</b><span>${lastExif.make ?? '—'} / ${lastExif.model ?? '—'}</span></div>`;
      html += `<div class="kv"><b>lensModel</b><span>${lastExif.lensModel ?? '—'}</span></div>`;
      html += `<div class="kv"><b>FocalLength</b><span class="${lastExif.focalLength!=null?'ok':'no'}">${lastExif.focalLength ?? 'not present'}</span></div>`;
      html += `<div class="kv"><b>FocalLengthIn35mmFilm</b><span class="${lastExif.focalLength35mm!=null?'ok':'no'}">${lastExif.focalLength35mm ?? 'not present'}</span></div>`;
      html += `<div class="kv"><b>SubjectDistance</b><span class="${lastExif.subjectDistance!=null?'ok':'no'}">${lastExif.subjectDistance ?? 'not present'}</span></div>`;
      html += `<div class="kv"><b>SubjectDistanceRange</b><span class="${lastExif.subjectDistanceRange!=null?'ok':'no'}">${lastExif.subjectDistanceRange ?? 'not present'}</span></div>`;
      html += `<div class="kv"><b>FNumber</b><span>${lastExif.fNumber ?? '—'}</span></div>`;
      out.innerHTML = html;
    }
    evaluateAndRenderVerdict();
  } catch (e) {
    out.innerHTML = `<div class="kv"><b>takePhoto() error</b><span class="no">${e.message}</span></div>`;
  }
});

// ---- verdict: is there ANY zero-calibration usable signal on this device? ----
const FALLBACK_MESSAGE = "We couldn't find a distance sensor on your phone that works for automatic sizing. To get an accurate fit, please place the reference object in your photo next to the tool -- we'll use that for scale instead.";

function evaluateAndRenderVerdict() {
  const caps = currentTrack && currentTrack.getCapabilities ? currentTrack.getCapabilities() : {};
  const signals = [];

  if (lastExif && (lastExif.subjectDistance != null || lastExif.subjectDistanceRange != null)) {
    signals.push({
      name: 'EXIF SubjectDistance',
      usable: true,
      note: 'This photo\'s camera pipeline reported a real subject distance directly in its metadata -- no calibration needed, works the moment it\'s present.'
    });
  }

  if (caps.focusDistance && caps.focusMode && caps.focusMode.includes('manual')) {
    signals.push({
      name: 'Manual focus sweep (depth-from-focus)',
      usable: 'conditional',
      note: 'The lens is drivable and readable, but converting a focus setting to a real distance needs a calibration table built per phone model. Not usable out of the box for a customer whose exact model we haven\'t calibrated.'
    });
  }

  // A second selectable back camera is only a HINT of a macro lens, not proof it behaves
  // differently -- it only counts as usable once EXIF or a measured distance test on that
  // specific device confirms a distinct, known-fixed focus geometry.
  signals.push({
    name: 'Continuous-mode focusDistance (live autofocus telemetry)',
    usable: false,
    note: 'Confirmed dead on every device tested so far -- Chrome does not update this field during autofocus, regardless of distance.'
  });

  const hasRealSignal = signals.some(s => s.usable === true);

  let html = '';
  signals.forEach(s => {
    const cls = s.usable === true ? 'ok' : s.usable === 'conditional' ? 'maybe' : 'no';
    const label = s.usable === true ? 'usable now' : s.usable === 'conditional' ? 'exists, not production-ready' : 'not usable';
    html += `<div class="kv"><b>${s.name}</b><span class="${cls}">${label}</span></div>`;
    html += `<div class="sub" style="margin:0 0 8px 0">${s.note}</div>`;
  });
  document.getElementById('verdictSignals').innerHTML = html;

  const banner = document.getElementById('verdictBanner');
  if (hasRealSignal) {
    banner.style.background = 'rgba(76,175,80,0.15)';
    banner.style.color = '#4caf50';
    banner.textContent = 'At least one zero-calibration signal is present on this device -- automatic sizing may be possible without a reference object.';
  } else {
    banner.style.background = 'rgba(239,83,80,0.15)';
    banner.style.color = '#ef5350';
    banner.textContent = 'No usable signal detected. Customer-facing message: "' + FALLBACK_MESSAGE + '"';
  }
  document.getElementById('verdictPanel').style.display = 'block';
}

document.getElementById('btnLog').addEventListener('click', () => {
  const val = parseFloat(document.getElementById('actualDist').value);
  if (isNaN(val)) { alert('Enter the tape reading in cm first'); return; }
  if (!lastExif) { alert('Take a photo first'); return; }
  log.push({
    camera: currentLabel,
    cm: val,
    focalLength: lastExif.focalLength ?? null,
    focalLength35mm: lastExif.focalLength35mm ?? null,
    subjectDistance: lastExif.subjectDistance ?? null,
    subjectDistanceRange: lastExif.subjectDistanceRange ?? null,
    zoom: lastMeta ? lastMeta.zoom : null,
  });
  persist();
  renderLog();
  document.getElementById('actualDist').value = '';
});

document.getElementById('btnDownload').addEventListener('click', () => {
  let csv = 'index,camera,actual_cm,focal_length,focal_length_35mm,subject_distance,subject_distance_range,zoom\n';
  log.forEach((r, i) => {
    csv += `${i},"${r.camera}",${r.cm ?? ''},${r.focalLength ?? ''},${r.focalLength35mm ?? ''},${r.subjectDistance ?? ''},${r.subjectDistanceRange ?? ''},${r.zoom ?? ''}\n`;
  });
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `macro-exif-log-${new Date().toISOString().replace(/[:.]/g, '-')}.csv`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
});

document.getElementById('btnClear').addEventListener('click', () => {
  if (!confirm('Clear all logged captures?')) return;
  log = [];
  persist();
  renderLog();
});
</script>
</body>
</html>
